{
  "version": 5,
  "cmakeMinimumRequired": {"major": 3, "minor": 24, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"BUILD_TESTING": "ON", "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"}
    },
    {
      "name": "windows-mingw",
      "displayName": "Windows MinGW - offline foundation",
      "inherits": "base",
      "generator": "MinGW Makefiles",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows Visual Studio 2022 - offline foundation",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"}
    },
    {
      "name": "linux-debug",
      "inherits": "base",
      "generator": "Unix Makefiles",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "windows-msvc-vcpkg",
      "displayName": "Windows MSVC - vcpkg and GoogleTest",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "PITWALL_USE_GOOGLETEST": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name": "windows-mingw", "configurePreset": "windows-mingw"},
    {"name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Debug"},
    {"name": "linux-debug", "configurePreset": "linux-debug"},
    {"name": "windows-msvc-vcpkg", "configurePreset": "windows-msvc-vcpkg", "configuration": "Debug"}
  ],
  "testPresets": [
    {"name": "windows-mingw", "configurePreset": "windows-mingw", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "windows-msvc", "configurePreset": "windows-msvc", "configuration": "Debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "linux-debug", "configurePreset": "linux-debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}},
    {"name": "windows-msvc-vcpkg", "configurePreset": "windows-msvc-vcpkg", "configuration": "Debug", "output": {"outputOnFailure": true}, "execution": {"noTestsAction": "error"}}
  ]
}
